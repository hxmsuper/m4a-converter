<Window x:Class="m4aToMp3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:m4aToMp3"
        mc:Ignorable="d"
        Title="m4a转换器 by clabs" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="拖拽或点击添加 .m4a 文件" FontSize="16" Margin="0,0,0,10"/>
        <ListBox x:Name="FileListBox" Grid.Row="1" AllowDrop="True" Height="200" BorderBrush="Gray" BorderThickness="1" Drop="FileListBox_Drop"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,10">
            <TextBlock Text="输出目录:" VerticalAlignment="Center"/>
            <TextBox x:Name="OutputDirTextBox" Width="300" Margin="5,0"/>
            <Button Content="选择..." Click="SelectOutputDir_Click"/>
            <TextBlock Text="目标格式:" VerticalAlignment="Center" Margin="20,0,5,0"/>
            <ComboBox x:Name="FormatComboBox" Width="80" SelectedIndex="0">
                <ComboBoxItem Content="opus"/>
                <ComboBoxItem Content="mp3"/>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="添加文件" Click="AddFiles_Click" Margin="0,0,10,0"/>
            <Button Content="开始转换" Click="StartConvert_Click"/>
        </StackPanel>
        <ProgressBar x:Name="ProgressBar" Grid.Row="4" Height="20" Margin="0,10,0,0" Minimum="0" Maximum="100"/>
    </Grid>
</Window>
